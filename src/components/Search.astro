---
// Client-side search that works in dev, build and preview (replaces Starlight's Pagefind-only search).
---
<site-search>
  <button type="button" class="hc-trigger" data-open aria-label="Search" aria-keyshortcuts="Control+K Meta+K /">
    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    <span class="hc-label">Search</span>
    <kbd class="hc-kbd">Ctrl K</kbd>
  </button>
  <dialog class="hc-dialog" aria-label="Search">
    <div class="hc-box">
      <div class="hc-input-row">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input type="search" class="hc-input" placeholder="Search pages, features, statuses…" autocomplete="off" spellcheck="false" aria-label="Search the docs" />
        <button type="button" class="hc-close" data-close aria-label="Close">Esc</button>
      </div>
      <ul class="hc-results" role="listbox"></ul>
      <p class="hc-empty" hidden></p>
      <p class="hc-hint">↑ ↓ to move · Enter to open · Esc to close</p>
    </div>
  </dialog>
</site-search>

<script>
  type Doc = { title: string; description: string; url: string; section: string; headings: string[]; text: string };
  const base = import.meta.env.BASE_URL.replace(/\/$/, '');
  let docs: Promise<Doc[]> | undefined;
  const load = () => (docs ??= fetch(`${base}/search-index.json`).then((r) => r.json()).catch(() => []));
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');

  function score(d: Doc, terms: string[]) {
    const t = norm(d.title), de = norm(d.description), h = norm(d.headings.join(' | ')), x = norm(d.text), sec = norm(d.section);
    let total = 0;
    for (const q of terms) {
      let s = 0;
      if (t === q) s += 100;
      else if (t.startsWith(q)) s += 60;
      else if (t.includes(q)) s += 40;
      if (sec.includes(q)) s += 6;
      if (h.includes(q)) s += 15;
      if (de.includes(q)) s += 10;
      if (x.includes(q)) s += 4;
      if (!s) return 0; // every word must match somewhere
      total += s;
    }
    return total;
  }

  function snippet(d: Doc, terms: string[]) {
    const x = d.text, n = norm(x);
    let at = -1;
    for (const q of terms) { at = n.indexOf(q); if (at >= 0) break; }
    const src = at < 0 ? d.description || x.slice(0, 120) : (at > 40 ? '… ' : '') + x.slice(Math.max(0, at - 40), at + 100) + ' …';
    let out = esc(src);
    for (const q of terms) out = out.replace(new RegExp(`(${q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi'), '<mark>$1</mark>');
    return out;
  }

  class SiteSearch extends HTMLElement {
    connectedCallback() {
      const dlg = this.querySelector('dialog')!, input = this.querySelector<HTMLInputElement>('.hc-input')!;
      const list = this.querySelector<HTMLUListElement>('.hc-results')!, empty = this.querySelector<HTMLElement>('.hc-empty')!;
      let active = 0;
      const open = () => { if (!dlg.open) dlg.showModal(); input.focus(); input.select(); load(); render(); };
      const close = () => dlg.open && dlg.close();
      const items = () => [...list.querySelectorAll<HTMLElement>('a')];
      const setActive = (i: number) => {
        const a = items(); if (!a.length) return;
        active = (i + a.length) % a.length;
        a.forEach((el, k) => { el.classList.toggle('on', k === active); el.setAttribute('aria-selected', String(k === active)); });
        a[active].scrollIntoView({ block: 'nearest' });
      };
      const render = async () => {
        const raw = input.value.trim();
        const all = await load();
        const terms = norm(raw).split(/\s+/).filter(Boolean);
        const hits = terms.length
          ? all.map((d) => ({ d, s: score(d, terms) })).filter((r) => r.s > 0).sort((a, b) => b.s - a.s).slice(0, 12).map((r) => r.d)
          : all.filter((d) => d.section).slice(0, 8);
        list.innerHTML = hits.map((d) => `<li><a href="${base}${d.url}" role="option"><span class="t">${esc(d.title)}<em>${esc(d.section || 'home')}</em></span><span class="s">${terms.length ? snippet(d, terms) : esc(d.description)}</span></a></li>`).join('');
        empty.hidden = hits.length > 0;
        empty.textContent = hits.length ? '' : `No results for “${raw}”. Try a page name like “inbox”, or a word like “mock”.`;
        setActive(0);
      };
      this.querySelector('[data-open]')!.addEventListener('click', open);
      this.querySelector('[data-close]')!.addEventListener('click', close);
      dlg.addEventListener('click', (e) => { if (e.target === dlg) close(); });
      input.addEventListener('input', render);
      input.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
        else if (e.key === 'Enter') { e.preventDefault(); items()[active]?.click(); }
      });
      window.addEventListener('keydown', (e) => {
        const typing = /^(INPUT|TEXTAREA|SELECT)$/.test((e.target as HTMLElement)?.tagName) || (e.target as HTMLElement)?.isContentEditable;
        if ((e.key === 'k' && (e.ctrlKey || e.metaKey)) || (e.key === '/' && !typing)) { e.preventDefault(); open(); }
      });
      const kbd = this.querySelector('.hc-kbd');
      if (kbd && /Mac|iPhone|iPad/.test(navigator.platform)) kbd.textContent = '⌘ K';
    }
  }
  if (!customElements.get('site-search')) customElements.define('site-search', SiteSearch);
</script>

<style is:global>
  site-search { display: contents; }
  .hc-trigger { display: flex; align-items: center; gap: .6rem; width: 100%; max-width: 22rem; padding: .45rem .75rem; border: 1px solid var(--sl-color-gray-5); border-radius: .5rem; background: var(--sl-color-black); color: var(--sl-color-gray-2); font: inherit; cursor: pointer; }
  .hc-trigger:hover { border-color: var(--sl-color-gray-3); }
  .hc-label { flex: 1; text-align: start; }
  .hc-kbd { font-size: .75rem; padding: .05rem .4rem; border: 1px solid var(--sl-color-gray-5); border-radius: .3rem; background: var(--sl-color-gray-6); }
  @media (max-width: 50rem) { .hc-trigger { width: auto; padding: .5rem; } .hc-label, .hc-kbd { display: none; } }
  .hc-dialog { margin: 8vh auto 0; padding: 0; width: min(40rem, calc(100vw - 2rem)); border: 1px solid var(--sl-color-gray-5); border-radius: .75rem; background: var(--sl-color-bg); color: var(--sl-color-text); box-shadow: 0 20px 60px rgb(0 0 0 / .35); }
  .hc-dialog::backdrop { background: rgb(0 0 0 / .5); backdrop-filter: blur(2px); }
  .hc-input-row { display: flex; align-items: center; gap: .6rem; padding: .8rem 1rem; border-bottom: 1px solid var(--sl-color-gray-5); color: var(--sl-color-gray-3); }
  .hc-input { flex: 1; border: 0; outline: 0; background: transparent; color: var(--sl-color-white); font: inherit; font-size: 1.05rem; }
  .hc-close { font: inherit; font-size: .75rem; padding: .1rem .45rem; border: 1px solid var(--sl-color-gray-5); border-radius: .3rem; background: var(--sl-color-gray-6); color: var(--sl-color-gray-2); cursor: pointer; }
  .hc-results { list-style: none; margin: 0; padding: .4rem; max-height: 55vh; overflow: auto; }
  .hc-results li { margin: 0; }
  .hc-results a { display: block; padding: .6rem .75rem; border-radius: .5rem; text-decoration: none; color: inherit; }
  .hc-results a.on, .hc-results a:hover { background: var(--sl-color-accent-low); }
  .hc-results .t { display: flex; align-items: center; gap: .5rem; font-weight: 600; color: var(--sl-color-white); }
  .hc-results .t em { font-style: normal; font-weight: 400; font-size: .72rem; text-transform: capitalize; padding: 0 .4rem; border-radius: 999px; border: 1px solid var(--sl-color-gray-5); color: var(--sl-color-gray-3); }
  .hc-results .s { display: block; margin-top: .15rem; font-size: .85rem; color: var(--sl-color-gray-2); line-height: 1.4; }
  .hc-results mark { background: color-mix(in srgb, var(--sl-color-accent) 35%, transparent); color: inherit; border-radius: .2rem; }
  .hc-empty, .hc-hint { margin: 0; padding: .75rem 1rem; font-size: .85rem; color: var(--sl-color-gray-3); }
  .hc-hint { border-top: 1px solid var(--sl-color-gray-5); font-size: .75rem; }
</style>
